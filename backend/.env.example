# Anthropic (primary paid dependency)
ANTHROPIC_API_KEY=

# Pinecone (free tier) - filing chunk index with integrated embedding
PINECONE_API_KEY=
PINECONE_INDEX_NAME=sec-filings
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# LangSmith (free tier) - tracing + eval, purely env-var driven
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=advisor-stock-copilot
# Only needed if your LangSmith workspace is region-pinned (e.g. AWS-hosted:
# https://aws.api.smith.langchain.com). Leave unset for the default US region.
LANGSMITH_ENDPOINT=

# CORS - frontend origin allowed to call this backend
FRONTEND_ORIGIN=http://localhost:3000

# SEC EDGAR requires a contact-identifying User-Agent on every request (fair-use policy)
SEC_EDGAR_CONTACT_EMAIL=you@example.com
